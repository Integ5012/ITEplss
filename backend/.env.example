PORT=4001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Azure SQL Database (ADO.NET style; use in code when you add a SQL client)
# SQL_CONNECTION_STRING=Server=tcp:your-server.database.windows.net,1433;...

# Azure Blob Storage (server-side uploads; prefer managed identity in production)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
